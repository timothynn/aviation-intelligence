{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timothynn/aviation-intelligence/schemas/aviation-core.schema.json",
  "title": "Aviation Intelligence Core Entity",
  "type": "object",
  "required": ["id", "entityType", "jurisdiction", "provenance"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "entityType": {"type": "string"},
    "jurisdiction": {"$ref": "#/$defs/jurisdiction"},
    "validity": {"$ref": "#/$defs/validity"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "attributes": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "jurisdiction": {
      "type": "object",
      "required": ["countryCode"],
      "properties": {
        "countryCode": {"type": "string", "minLength": 2, "maxLength": 2},
        "authorityId": {"type": "string"},
        "region": {"type": "string"}
      }
    },
    "validity": {
      "type": "object",
      "properties": {
        "effectiveFrom": {"type": "string", "format": "date-time"},
        "effectiveTo": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sourceType", "sourceId"],
      "properties": {
        "sourceType": {"type": "string"},
        "sourceId": {"type": "string"},
        "sourceVersion": {"type": "string"},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "locator": {"type": "string"}
      }
    },
    "relationship": {
      "type": "object",
      "required": ["type", "targetId"],
      "properties": {
        "type": {"type": "string"},
        "targetId": {"type": "string"},
        "validFrom": {"type": ["string", "null"], "format": "date-time"},
        "validTo": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}